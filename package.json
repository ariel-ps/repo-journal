{
  "name": "repo-journal-axi",
  "version": "0.3.1",
  "description": "AXI-compliant Repo Journal CLI — git-root .journal/ scratch, TOON output, gitignore policy",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/ariel-ps/repo-journal.git"
  },
  "keywords": ["repo", "journal", "git", "cli", "agent", "axi", "toon"],
  "bin": {
    "repo-journal": "dist/bin/repo-journal.js"
  },
  "files": ["dist", "skills/repo-journal", "LICENSE", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json && bun build ./bin/repo-journal.ts --target=node --outfile=./dist/bin/repo-journal.js",
    "test": "vitest run",
    "dev": "node --import tsx bin/repo-journal.ts"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@toon-format/toon": "^2.3.1",
    "axi-sdk-js": "^0.1.12"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsx": "^4.20.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
