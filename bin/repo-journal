#!/usr/bin/env bash
# repo-journal: AXI CLI wrapper (Node 20+). Falls back to plugin-root dist build.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CLI="$ROOT/dist/bin/repo-journal.js"

if [ ! -f "$CLI" ]; then
  echo "repo-journal: missing $CLI (run: bun install --registry https://registry.npmjs.org && bun run build)" >&2
  exit 1
fi

if ! command -v node >/dev/null 2>&1; then
  echo "repo-journal: node >= 20 is required on PATH" >&2
  exit 1
fi
if ! node -e 'process.exit(Number(process.versions.node.split(".")[0]) >= 20 ? 0 : 1)'; then
  echo "repo-journal: node >= 20 is required on PATH" >&2
  exit 1
fi

exec node "$CLI" "$@"
